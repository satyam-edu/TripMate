//Prisma Schema file. It tells PostgreSQL database exactly what tables to create.

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  NEW_REQUEST
  REQUEST_APPROVED
  REQUEST_DECLINED
  REVIEW_RECEIVED
}

enum ReportReason {
  SPAM
  HARASSMENT
  FAKE_PROFILE
  SAFETY_CONCERN
  OTHER
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// 1. The User Table (Based on our Onboarding Flow)
model User {
  id        String   @id @default(uuid())
  googleId  String   @unique
  name      String
  gender    String?
  avatar    String? // Google photo URL, or an uploaded photo (/api/images/<id>)
  coverImage String? // Uploaded profile cover (/api/images/<id>)
  phone     String?  @unique
  bio       String?
  location     String? // e.g., "Delhi, India"
  socialHandle String? // Instagram / LinkedIn URL, social proof for trust
  tags      String[] // e.g., ["Backpacker", "Luxury"]
  trips     Trip[]   @relation("HostTrips") // Trips this user created
  requests  Request[] // Trips this user has requested to join
  messages  Message[] // Chat messages this user sent
  notifications Notification[] // Bell notifications for this user
  chatReads     ChatRead[] // When this user last read each chat (for unread counts)
  reviewsGiven    Review[] @relation("ReviewsGiven") // Reviews this user wrote
  reviewsReceived Review[] @relation("ReviewsReceived") // Reviews written about this user
  blocksMade     Block[]  @relation("BlocksMade")     // Users this user has blocked
  blocksReceived Block[]  @relation("BlocksReceived") // Users who have blocked this user
  reportsMade    Report[] @relation("ReportsMade")    // Reports this user has filed
  reportsReceived Report[] @relation("ReportsReceived") // Reports filed against this user
  createdAt DateTime @default(now())
}

// 2. The Trip Table (Based on our Post Flow)
model Trip {
  id          String    @id @default(uuid())
  hostId      String
  host        User      @relation("HostTrips", fields: [hostId], references: [id])
  destination String
  country     String
  startDate   DateTime
  endDate     DateTime
  budget      Int       // Stored in INR (₹)
  maxGuests   Int
  tags        String[]
  coverImage  String?
  description String?
  requests    Request[] // All the requests sent to this trip
  messages    Message[] // Group chat + inquiry messages for this trip
  reviews     Review[] // Reviews left about the trip (host <-> travellers)
  createdAt   DateTime  @default(now())
}

// 3. The Request Table (Based on our Inbox/Alerts Flow)
model Request {
  id        String   @id @default(uuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  status    RequestStatus @default(PENDING)
  message   String?
  messages  Message[] // 1-on-1 inquiry chat between the requester and the host
  createdAt DateTime      @default(now())

  // This strict rule prevents a user from spam-clicking "Join" on the same trip
  @@unique([tripId, userId])
}

// 4. The Message Table (Chats)
// requestId null → trip group chat (host + approved travellers)
// requestId set  → inquiry chat (requester + host)
model Message {
  id        String   @id @default(uuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  requestId String?
  request   Request? @relation(fields: [requestId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])
  text      String
  // Optional quoted message this one replies to (same chat). Deleting it keeps the reply.
  replyToId String?
  replyTo   Message?  @relation("Replies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[] @relation("Replies")
  createdAt DateTime @default(now())

  @@index([tripId, createdAt])
  @@index([requestId, createdAt])
}

// 5. The Notification Table (Bell on Home)
// `text` is stored ready to show, so it still reads right if the trip is later deleted.
model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  text      String
  link      String // in-app path to open, e.g. "/requests"
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
}

// 6. The ChatRead Table (unread chat counts)
// One row per user per chat. chatKey = "groups:<tripId>" or "inquiries:<requestId>".
// Messages from others newer than lastReadAt are unread.
model ChatRead {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatKey    String
  lastReadAt DateTime

  @@id([userId, chatKey])
}

// 7. The Image Table (uploaded profile photos and covers)
// Stored in the database so no extra storage service is needed; served by GET /api/images/:id.
// ponytail: fine for small, resized images; move to object storage (S3/R2/Cloudinary) if uploads grow.
model Image {
  id        String   @id @default(uuid())
  data      Bytes
  mimeType  String
  createdAt DateTime @default(now())
}

// 8. The Review Table (host <-> traveller ratings, once a trip has ended)
model Review {
  id         String   @id @default(uuid())
  tripId     String
  trip       Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  reviewerId String
  reviewer   User     @relation("ReviewsGiven", fields: [reviewerId], references: [id], onDelete: Cascade)
  revieweeId String
  reviewee   User     @relation("ReviewsReceived", fields: [revieweeId], references: [id], onDelete: Cascade)
  rating     Int      // 1-5
  text       String?
  createdAt  DateTime @default(now())

  // One review per person, per trip, per direction.
  @@unique([tripId, reviewerId, revieweeId])
  @@index([revieweeId])
}

// 9. Block + Report (safety)
model Block {
  id        String   @id @default(uuid())
  blockerId String
  blocker   User     @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
}

model Report {
  id         String       @id @default(uuid())
  reporterId String
  reporter   User         @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedId String
  reported   User         @relation("ReportsReceived", fields: [reportedId], references: [id], onDelete: Cascade)
  reason     ReportReason
  details    String?
  createdAt  DateTime     @default(now())

  @@index([reportedId])
}
